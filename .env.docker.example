# Docker Compose Environment Variables Template
# Copy this file to .env and fill in your actual values

# Django Settings
SECRET_KEY=your_django_secret_key_here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com,www.yourdomain.com

# Compete Database (Django/Web Application)
DB_NAME=compete_db
DB_USER=compete_user
DB_PASSWORD=your_secure_password_here
DB_HOST=app_db
DB_PORT=5432

# Judge0 Database
JUDGE0_DB_NAME=judge0_db
JUDGE0_DB_USER=judge0
JUDGE0_DB_PASSWORD=your_secure_password_here

# Email Configuration (Postmark)
EMAIL_HOST=smtp.postmarkapp.com
EMAIL_PORT=2525
EMAIL_HOST_USER=your_postmark_api_token_here
EMAIL_HOST_PASSWORD=your_postmark_api_token_here

# Optional: Redis Password
# REDIS_PASSWORD=your_redis_password_here
