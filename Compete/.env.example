# ==================================================
# COMPETE CTF - PRODUCTION ENVIRONMENT CONFIGURATION
# ==================================================
# Copy this file to .env and update with your values
# NEVER commit .env to version control!

# Django Core Settings
SECRET_KEY=your-secret-key-here-generate-a-new-one
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# Database Configuration (PostgreSQL Required for Production)
USE_POSTGRESQL=True
DB_NAME=compete_db
DB_USER=compete_user
DB_PASSWORD=your-secure-database-password
DB_HOST=localhost
DB_PORT=5432

# Email Configuration (SMTP Required for Production)
USE_SMTP_EMAIL=True
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=noreply@yourdomain.com
EMAIL_HOST_PASSWORD=your-email-app-password
DEFAULT_FROM_EMAIL=noreply@compete-ctf.com
SERVER_EMAIL=server@compete-ctf.com
ADMIN_EMAIL=admin@compete-ctf.com

# Security Settings (Production Defaults - Already Secure)
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SECURE_CONTENT_TYPE_NOSNIFF=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
CSRF_COOKIE_HTTPONLY=True
X_FRAME_OPTIONS=DENY
SECURE_REFERRER_POLICY=same-origin
SECURE_BROWSER_XSS_FILTER=True

# CSRF Trusted Origins (comma-separated)
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ==================================================
# DEVELOPMENT MODE (Optional Override)
# ==================================================
# Uncomment these lines for local development:
# DEBUG=True
# USE_POSTGRESQL=False
# USE_SMTP_EMAIL=False
# ALLOWED_HOSTS=localhost,127.0.0.1
# SECURE_SSL_REDIRECT=False
# SESSION_COOKIE_SECURE=False
# CSRF_COOKIE_SECURE=False

# ==================================================
# SETUP INSTRUCTIONS
# ==================================================
# 1. Copy this file: cp .env.example .env
# 2. Generate SECRET_KEY:
#    python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# 3. Update all values with your actual configuration
# 4. Never commit .env to git (it's in .gitignore)
# 5. Run migrations: python manage.py migrate
# 6. Collect static: python manage.py collectstatic
# 7. Create superuser: python manage.py createsuperuser
